# Copy to .env and fill in. Nothing here is required to run the demo -
# every variable has a working default in agentportal/settings.py.

# Django. Generate a real key before any deployment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. With a key the in-portal assistant answers through Claude;
# without one it falls back to matching questions against the database.
ANTHROPIC_API_KEY=
